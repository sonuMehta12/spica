<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paper behind everything, before the first Compose frame draws. -->
    <style name="Theme.Spica" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="paper">#FFFFFF</color>
    <color name="brand">#732F67</color>
</resources>
