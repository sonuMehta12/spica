<?xml version="1.0" encoding="utf-8"?>
<!-- The Constellation, in white on the Jamun tile: a centre dot, four mid dots
     on the axes and four small ones on the diagonals, drawn on the mark's own
     96-unit grid. An icon always shows small, so the outer dots wear their
     small-size weight (6.5 and 4). Scaled 0.84 about the centre and moved onto
     the 108 dp canvas's: the mark is 58 dp across, inside the 66 dp safe zone.
     Also the monochrome layer, where only its alpha counts. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="48"
        android:pivotY="48"
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateX="6"
        android:translateY="6">
        <!-- centre, r 10 -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M38,48a10,10 0,1 1,20,0a10,10 0,1 1,-20,0Z" />
        <!-- mid dots, r 6.5: top, right, bottom, left -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M41.5,20a6.5,6.5 0,1 1,13,0a6.5,6.5 0,1 1,-13,0Z M69.5,48a6.5,6.5 0,1 1,13,0a6.5,6.5 0,1 1,-13,0Z M41.5,76a6.5,6.5 0,1 1,13,0a6.5,6.5 0,1 1,-13,0Z M13.5,48a6.5,6.5 0,1 1,13,0a6.5,6.5 0,1 1,-13,0Z" />
        <!-- diagonal dots, r 4 -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M64,28a4,4 0,1 1,8,0a4,4 0,1 1,-8,0Z M64,68a4,4 0,1 1,8,0a4,4 0,1 1,-8,0Z M24,68a4,4 0,1 1,8,0a4,4 0,1 1,-8,0Z M24,28a4,4 0,1 1,8,0a4,4 0,1 1,-8,0Z" />
    </group>
</vector>
