# The API project's settings on Vercel. spec/in-progress/deploy.md § Settings.
#
# Copy to deploy.env (git ignores it), fill it in, and paste the whole file
# into the project's Environment Variables for Production — Vercel turns a
# pasted .env into one row per key. Then delete deploy.env: it holds the
# database password and the model key, which live in Vercel and GitHub and
# nowhere else.
#
# <api> and <web> are the two production addresses — the hosts the projects'
# Settings → Domains show, which differ from the project names when a name's
# .vercel.app was taken. Both are baked into the web bundle and the APK.

# Neon's DIRECT connection string — pooling off, no `-pooler` in the host —
# pasted as given. app/config.py turns it into the form asyncpg takes.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.ap-southeast-1.aws.neon.tech/<db>?sslmode=require&channel_binding=require

# A connection per transaction, none held between requests: Vercel pauses an
# instance between requests, and a held connection keeps Neon awake.
DB_NULL_POOL=true

# The OpenAI key. Here and in GitHub's repo secrets, nowhere else.
OPENAI_API_KEY=<key>

# The existing Web application client ID from Google Cloud, unchanged.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# Who may create an account: the friends' Gmail addresses, comma-separated.
# Never the owner's: the owner gets in by claiming the seeded row, so a claim
# missed or mistyped is refused at sign-in rather than making a second account.
ALLOWED_EMAILS=<friend>@gmail.com

# Where this API is reached from outside: the OAuth issuer and the base of /mcp.
PUBLIC_URL=https://<api>.vercel.app

# Where the web app is served — claude.ai sends a person to its /connect page.
APP_URL=https://<web>.vercel.app

# The web origin, as a regex with the dots escaped. It replaces the local
# default: the deployed web app is the one origin a browser lets call this
# API. The phone is not a browser and needs no entry.
CORS_ORIGIN_REGEX=^https://<web>\.vercel\.app$

# The ceilings, as now (these are the defaults in app/config.py): turns a
# person may take a day, accounts created a day, first-run answers a day.
DAILY_TURN_LIMIT=100
DAILY_SIGNUP_LIMIT=20
ONBOARDING_TURN_LIMIT=40
