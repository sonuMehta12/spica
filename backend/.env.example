# 5434, not 5432 — kestrel and novacart already hold the lower ports
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5434/cortex

# Sign-in (spec/in-progress/sign-in.md). The Web application client ID from
# Google Cloud — public by design, it ships inside the page. The client SECRET
# is not used: the ID-token flow never exchanges a code, so do not add one.
GOOGLE_CLIENT_ID=

# Who may CREATE an account: a comma-separated list, or * for anyone with a
# verified Google email. An existing user always signs in, whatever this says.
# Open it only once DELETE /users/me and a privacy policy exist — every turn
# any user takes is billed to the key below.
ALLOWED_EMAILS=

# The ceiling that makes an open door safe to open.
DAILY_TURN_LIMIT=100
DAILY_SIGNUP_LIMIT=20

# Only app/llm.py ever reads this. Nothing else imports the SDK, so swapping
# provider is one file (spec/backend.md).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# How much conversation the agent is given, and when it is compacted.
# CHAT_WINDOW is the floor a compaction folds back to; CHAT_FOLD_AT is the
# ceiling the tail reaches first. Batching keeps the message list append-only
# in between, which is what a prompt cache rewards. spec/done/prompt-layout.md
CHAT_WINDOW=20
CHAT_FOLD_AT=40
CHAT_SUMMARY_WORDS=200

# The MCP server and its OAuth (spec/work-sync.md § Auth). PUBLIC_URL is where
# this server is reached from outside — the OAuth issuer, and the base of the
# /mcp URL claude.ai is given; on Render, the service's https:// URL. APP_URL is
# where the app is served: claude.ai sends the person to its /connect page to
# approve the connector, so the app must be reachable too.
PUBLIC_URL=http://localhost:8001
APP_URL=http://localhost:5173
# Token lifetimes. The routine refreshes quietly, so a short access token is
# free; the refresh token is renewed on every use.
MCP_ACCESS_HOURS=24
MCP_REFRESH_DAYS=90
